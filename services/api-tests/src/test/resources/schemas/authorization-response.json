{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AuthorizationResponse (docs/api-spec.md, раздел 3; common/.../AuthorizationResponse.java)",
  "type": "object",
  "required": ["mti", "stan", "responseCode", "status", "processingTimeMs"],
  "properties": {
    "mti": {"type": "string", "pattern": "^\\d{4}$"},
    "stan": {"type": "string", "pattern": "^\\d{6}$"},
    "rrn": {"type": ["string", "null"], "pattern": "^\\d{12}$"},
    "authCode": {"type": ["string", "null"], "pattern": "^[0-9A-Z]{6}$"},
    "responseCode": {"type": "string", "pattern": "^\\d{2}$"},
    "status": {"type": "string", "enum": ["APPROVED", "DECLINED"]},
    "declineReason": {"type": ["string", "null"]},
    "processingTimeMs": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
