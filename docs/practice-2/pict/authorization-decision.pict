# Авторизация: комбинации параметров (AUTH-2, AUTH-4…AUTH-10)
# Классы значений и рецепт подготовки данных — test-design.md §5.4
card_status: ACTIVE, INACTIVE, BLOCKED, EXPIRED
expiry:      PAST, CURRENT_MONTH, FUTURE
daily:       WITHIN, ON_LIMIT, OVER
monthly:     WITHIN, ON_LIMIT, OVER
balance:     WITHIN, EQUAL, OVER
bin:         400000, 400001, 400002, 400003, 400004
bin_lookup:  OK, HTTP_5XX, UNAVAILABLE

# Маскирование: если отказ уже наступил на более ранней проверке (C2, C3, C4, C5),
# значения последующих проверок не влияют на ответ. Фиксируем их в WITHIN,
# чтобы пары граничных значений попадали в строки, где они реально проверяются.
IF [card_status] <> "ACTIVE" OR [expiry] = "PAST" THEN [daily] = "WITHIN" AND [monthly] = "WITHIN" AND [balance] = "WITHIN";
IF [daily] = "OVER" THEN [monthly] = "WITHIN" AND [balance] = "WITHIN";
IF [monthly] = "OVER" THEN [balance] = "WITHIN";

# Статус EXPIRED с будущим сроком даёт тот же код 54, что и без него: строка не несёт информации.
IF [card_status] = "EXPIRED" THEN [expiry] = "PAST";
